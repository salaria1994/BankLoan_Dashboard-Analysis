# Good loan percentage
with cte_A as(
select 
Count(id) as goodloannumber
from `Bankloanpro.loanAnalysis`
where loan_status IN ("Fully Paid","Current")
)
select (cte_A.goodloannumber *100  / (
  select count(id) as total
  from `Bankloanpro.loanAnalysis`
) )as good_loan_rate
from cte_A;

#OR

SELECT
    (COUNT(CASE WHEN loan_status IN ('Fully Paid', 'Current') THEN id ELSE NULL END) * 100.0 / COUNT(id)) AS good_loan_rate
FROM
    Bankloanpro.loanAnalysis;

