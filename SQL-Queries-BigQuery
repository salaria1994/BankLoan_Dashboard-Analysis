select * from `Bankloanpro.loanAnalysis`;

# Find total number of loan applications

Select count(id) as  Total_loan_applications
from `Bankloanpro.loanAnalysis`;

# Total month to date loan applications

select count(id) as number_of_loans
from `Bankloanpro.loanAnalysis`
where EXTRACT(MONTH FROM issue_date)=12;

# Total PREVIOUS month to date loan applications

select count(id) as number_of_loans
from `Bankloanpro.loanAnalysis`
where EXTRACT(MONTH FROM issue_date)=11;


